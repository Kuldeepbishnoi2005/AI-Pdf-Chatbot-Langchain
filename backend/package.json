{
  "name": "ai-pdf-chatbot-backend",
  "version": "1.0.0",
  "description": "Backend for AI PDF Chatbot using LangChain, LangGraph, Supabase pgvector, and Google Gemini",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/gemini-retry.test.ts",
    "langgraph:dev": "langgraph dev"
  },
  "dependencies": {
    "@langchain/community": "^0.3.30",
    "@langchain/core": "^0.3.40",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.2.50",
    "@langchain/textsplitters": "^0.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
